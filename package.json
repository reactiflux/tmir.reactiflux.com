{
  "name": "tmir",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "postbuild": "node scripts/og.ts && pagefind --site dist/client",
    "preview": "vite preview",
    "check": "node --env-file-if-exists=.env --test scripts/check-build.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "format": "prettier --write .",
    "doctor": "react-doctor --no-telemetry --blocking warning",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "publish": "node --env-file-if-exists=.env scripts/publish.ts",
    "ingest": "node --env-file-if-exists=.env scripts/ingest.ts",
    "publish-transcript": "node --env-file-if-exists=.env scripts/publish-transcript.ts",
    "publish-atproto": "node --env-file-if-exists=.env scripts/publish-atproto.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.20.42",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-start": "1.168.52",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "1.3.19",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "jpeg-js": "^0.4.4",
    "pagefind": "1.5.2",
    "prettier": "^3.3.0",
    "react-doctor": "0.9.13",
    "satori": "^0.33.4",
    "typescript": "6.0.3",
    "typescript-native": "npm:typescript@7.0.2",
    "vite": "8.3.0"
  }
}
