{
  "name": "tmir",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "postbuild": "node scripts/og.ts && pagefind --site dist/client",
    "preview": "vite preview",
    "check": "node scripts/check-build.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "format": "prettier --write .",
    "ingest": "node --env-file-if-exists=.env scripts/ingest.ts",
    "publish-transcript": "node --env-file-if-exists=.env scripts/publish-transcript.ts",
    "publish-atproto": "node --env-file-if-exists=.env scripts/publish-atproto.ts"
  },
  "dependencies": {
    "@atproto/api": "^0.20.42",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "1.3.19",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "22.12.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "pagefind": "1.5.2",
    "prettier": "^3.3.0",
    "satori": "^0.33.4",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
